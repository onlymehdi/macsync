#!/usr/bin/env python3
import json, os, subprocess, sys, socket, datetime

# ---- Pro switch: set to False later to require a license ----
PRO_ENABLED = True

SYNC_DIR = os.path.expanduser("~/Library/Mobile Documents/com~apple~CloudDocs/MacSync")
SNAP = os.path.join(SYNC_DIR, "snapshot.json")
PRO_SNAP = os.path.join(SYNC_DIR, "pro-settings.json")

# Settings synced by pro. Each entry: (domain, key, type)
PRO_SETTINGS = [
    # Trackpad
    ("com.apple.AppleMultitouchTrackpad", "Clicking", "bool"),
    ("com.apple.AppleMultitouchTrackpad", "TrackpadThreeFingerDrag", "bool"),
    ("com.apple.AppleMultitouchTrackpad", "TrackpadRightClick", "bool"),
    ("NSGlobalDomain", "com.apple.swipescrolldirection", "bool"),
    ("NSGlobalDomain", "com.apple.trackpad.scaling", "float"),
    # Mouse
    ("NSGlobalDomain", "com.apple.mouse.scaling", "float"),
    # Keyboard
    ("NSGlobalDomain", "KeyRepeat", "int"),
    ("NSGlobalDomain", "InitialKeyRepeat", "int"),
    ("NSGlobalDomain", "ApplePressAndHoldEnabled", "bool"),
    ("NSGlobalDomain", "NSAutomaticSpellingCorrectionEnabled", "bool"),
    ("NSGlobalDomain", "NSAutomaticCapitalizationEnabled", "bool"),
    ("NSGlobalDomain", "NSAutomaticPeriodSubstitutionEnabled", "bool"),
    ("NSGlobalDomain", "AppleKeyboardUIMode", "int"),
    # Finder
    ("com.apple.finder", "AppleShowAllFiles", "bool"),
    ("com.apple.finder", "ShowPathbar", "bool"),
    ("com.apple.finder", "ShowStatusBar", "bool"),
    ("com.apple.finder", "FXPreferredViewStyle", "string"),
    ("com.apple.finder", "FXDefaultSearchScope", "string"),
    ("com.apple.finder", "_FXSortFoldersFirst", "bool"),
    ("NSGlobalDomain", "AppleShowAllExtensions", "bool"),
    # Dock behavior
    ("com.apple.dock", "tilesize", "int"),
    ("com.apple.dock", "magnification", "bool"),
    ("com.apple.dock", "largesize", "int"),
    ("com.apple.dock", "orientation", "string"),
    ("com.apple.dock", "autohide", "bool"),
    ("com.apple.dock", "autohide-delay", "float"),
    ("com.apple.dock", "show-recents", "bool"),
    ("com.apple.dock", "minimize-to-application", "bool"),
    ("com.apple.dock", "mineffect", "string"),
    # Display and appearance
    ("NSGlobalDomain", "AppleInterfaceStyle", "string"),
    ("NSGlobalDomain", "AppleInterfaceStyleSwitchesAutomatically", "bool"),
    ("NSGlobalDomain", "AppleShowScrollBars", "string"),
    # Screenshots
    ("com.apple.screencapture", "location", "string"),
    ("com.apple.screencapture", "type", "string"),
    ("com.apple.screencapture", "disable-shadow", "bool"),
]

# App preference domains copied as whole plist files (if present)
APP_PREFS = [
    "com.raycast.macos",
]


def run(cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    return r.stdout.strip()


def require_pro():
    if not PRO_ENABLED:
        print("This is a Pro command. License check is not set up yet.")
        sys.exit(1)


def read_default(domain, key, typ):
    r = subprocess.run(["defaults", "read", domain, key], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    val = r.stdout.strip()
    if typ == "bool":
        return val in ("1", "true", "yes")
    if typ == "int":
        try:
            return int(val)
        except ValueError:
            return None
    if typ == "float":
        try:
            return float(val)
        except ValueError:
            return None
    return val


def write_default(domain, key, typ, val):
    if val is None:
        return False
    if typ == "bool":
        args = ["-bool", "true" if val else "false"]
    elif typ == "int":
        args = ["-int", str(val)]
    elif typ == "float":
        args = ["-float", str(val)]
    else:
        args = ["-string", str(val)]
    r = subprocess.run(["defaults", "write", domain, key] + args, capture_output=True, text=True)
    return r.returncode == 0


def export_plist(domain):
    r = subprocess.run(["defaults", "export", domain, "-"], capture_output=True)
    if r.returncode != 0 or not r.stdout:
        return None
    return r.stdout.decode("utf-8", errors="replace")


def import_plist(domain, text):
    r = subprocess.run(["defaults", "import", domain, "-"], input=text.encode("utf-8"), capture_output=True)
    return r.returncode == 0


def pro_push():
    require_pro()
    os.makedirs(SYNC_DIR, exist_ok=True)
    settings = []
    for domain, key, typ in PRO_SETTINGS:
        val = read_default(domain, key, typ)
        if val is not None:
            settings.append({"domain": domain, "key": key, "type": typ, "value": val})
    apps = {}
    for dom in APP_PREFS:
        data = export_plist(dom)
        if data:
            apps[dom] = data
    snap = {
        "host": socket.gethostname(),
        "time": datetime.datetime.now().isoformat(timespec="seconds"),
        "settings": settings,
        "apps": apps,
    }
    with open(PRO_SNAP, "w") as f:
        json.dump(snap, f, indent=2)
    print(f"Pro saved {len(settings)} settings and {len(apps)} app preference sets.")


def pro_pull():
    require_pro()
    if not os.path.exists(PRO_SNAP):
        print("No pro snapshot found. Run pro-push on your main Mac first.")
        sys.exit(1)
    snap = json.load(open(PRO_SNAP))
    ok = 0
    for s in snap["settings"]:
        if write_default(s["domain"], s["key"], s["type"], s["value"]):
            ok += 1
    for dom, text in snap.get("apps", {}).items():
        import_plist(dom, text)
    for proc in ("Dock", "Finder", "SystemUIServer", "cfprefsd"):
        subprocess.run(["killall", proc], capture_output=True)
    print(f"Pro applied {ok} settings and {len(snap.get('apps', {}))} app preference sets from {snap['host']}.")
    print("Some changes (trackpad, keyboard, appearance) may need a log out to fully apply.")


def pro_status():
    require_pro()
    if not os.path.exists(PRO_SNAP):
        print("No pro snapshot yet.")
        return
    s = json.load(open(PRO_SNAP))
    print(f"Last pro push from {s['host']} at {s['time']}: {len(s['settings'])} settings, {len(s['apps'])} app preference sets.")


def get_dock():
    out = run(["dockutil", "--list"])
    items = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 3 and parts[2] == "persistentApps":
            items.append({"label": parts[0], "path": parts[1].replace("file://", "").replace("%20", " ").rstrip("/")})
    return items


def get_brew():
    casks = run(["brew", "list", "--cask"]).split()
    formulae = run(["brew", "leaves"]).split()
    return {"casks": casks, "formulae": formulae}


def get_mas():
    apps = []
    for line in run(["mas", "list"]).splitlines():
        parts = line.split(None, 1)
        if parts and parts[0].isdigit():
            apps.append({"id": parts[0], "name": parts[1] if len(parts) > 1 else ""})
    return apps


def push():
    os.makedirs(SYNC_DIR, exist_ok=True)
    snap = {
        "host": socket.gethostname(),
        "time": datetime.datetime.now().isoformat(timespec="seconds"),
        "dock": get_dock(),
        "brew": get_brew(),
        "mas": get_mas(),
    }
    with open(SNAP, "w") as f:
        json.dump(snap, f, indent=2)
    print(f"Saved {len(snap['dock'])} dock items, {len(snap['brew']['casks'])} casks, {len(snap['mas'])} App Store apps.")


def pull():
    if not os.path.exists(SNAP):
        print("No snapshot found. Run push on your main Mac first.")
        sys.exit(1)
    snap = json.load(open(SNAP))
    for c in snap["brew"]["casks"]:
        subprocess.run(["brew", "install", "--cask", c])
    for fm in snap["brew"]["formulae"]:
        subprocess.run(["brew", "install", fm])
    for a in snap["mas"]:
        subprocess.run(["mas", "install", a["id"]])
    subprocess.run(["dockutil", "--remove", "all", "--no-restart"])
    for item in snap["dock"]:
        if os.path.exists(item["path"]):
            subprocess.run(["dockutil", "--add", item["path"], "--no-restart"])
    subprocess.run(["killall", "Dock"])
    print(f"Restored from {snap['host']} saved {snap['time']}.")


def status():
    if not os.path.exists(SNAP):
        print("No snapshot yet.")
        return
    s = json.load(open(SNAP))
    print(f"Last push from {s['host']} at {s['time']}: {len(s['dock'])} dock items, {len(s['brew']['casks'])} casks, {len(s['mas'])} App Store apps.")


COMMANDS = {
    "push": push, "pull": pull, "status": status,
    "pro-push": pro_push, "pro-pull": pro_pull, "pro-status": pro_status,
}

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd not in COMMANDS:
        print("Usage: macsync [push|pull|status|pro-push|pro-pull|pro-status]")
        sys.exit(1)
    COMMANDS[cmd]()
